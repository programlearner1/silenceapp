# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Email Configuration
EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# Server Configuration
PORT=5000

# Firebase Admin SDK Configuration
# Instructions to set up:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key"
# 3. Save the JSON file
# 4. Convert to base64 using PowerShell:
# [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Content -Raw "path-to-your-service-account.json")))
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_here

# WhatsApp Cloud API Configuration (if needed)
# Get these from Meta Developers Console
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here 